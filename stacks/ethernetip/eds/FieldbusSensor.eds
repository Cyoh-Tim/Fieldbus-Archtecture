[File]
DescText = "Fieldbus Architecture EtherNet/IP Sensor Adapter";
CreateDate = 09-08-2026;
CreateTime = 11:15:00;
ModDate = 09-08-2026;
ModTime = 11:15:00;
Revision = 1.1;
HomeURL = "https://github.com/Cyoh-Tim/Fieldbus-Archtecture";

[Device]
VendCode = 43981;
VendName = "FieldbusArch";
ProdType = 12;
ProdTypeStr = "Communications Adapter";
ProdCode = 1;
MajRev = 1;
MinRev = 0;
ProdName = "FieldbusSensor";
Catalog = "FB-EIP-SENSOR";

[Device Classification]
Class1 = EtherNet/IP;

[Params]
Param1 =
    0,                  $ first field shall equal 0
    6,0,                $ assembly link path size/path (placeholder)
    0x0000,             $ descriptor
    0xC7,               $ data type = UINT
    2,                  $ data size in bytes
    "Input Size",       $ name
    "",                 $ units
    "",                 $ help
    1,2048,32,          $ min,max,default
    1,1,1,0,            $ mult,div,base,offset scaling
    0,0,0,0,            $ mult,div,base,offset links
    0;                  $ decimal places

Param2 =
    0,                  $ reserved
    0,,                 $ link path size, link path (none)
    0x0000,             $ descriptor
    0xC8,               $ data type = UDINT
    4,                  $ data size in bytes
    "RPI",              $ name
    "us",               $ units
    "Requested Packet Interval",
    8000,1000000,8000,  $ min,max,default (min = example cycle_ms 8 x 1000)
    1,1,1,0,
    0,0,0,0,
    0;

[Assembly]
Assem100 =
    "Config", ,
    1,
    1,1,1;

Assem101 =
    "Output (O->T)", ,
    128,
    ;

Assem150 =
    "Input (T->O)", ,
    512,
    ;

[Connection Manager]
Connection1 =
    0x04010002,         $ trigger & transport: Class 1, cyclic, exclusive owner
    0x44640405,         $ O->T 32-bit Run/Idle, T->O pure data
    Param2,,Assem101,   $ O->T RPI, size, format
    Param2,,Assem150,   $ T->O RPI, size, format
    ,,                  $ config 1 size, format
    ,,                  $ config 2 size, format
    "Exclusive Owner",  $ name
    "",                 $ help
    "20 04 24 64 2C 65 2C 96";  $ path: Assembly, config 100, O->T 101, T->O 150

[Port]
Port1 =
    TCP,                $ port type
    "EtherNet/IP",      $ name
    "20 F5 24 01",      $ TCP/IP Interface object, instance 1
    2;                  $ port number

[Capacity]
MaxCIPConnections = 64;
MaxIOConnections = 32;
MaxMsgConnections = 32;
TSpec1 = TCP, 44818;
TSpec2 = UDP, 2222;
TSpec3 = TCP, 2221;

[LLDP Management]
Revision = 1;
MaxInst = 1;
Number_Of_Static_Instances = 1;
Object_Name = "LLDP Management Object";
Object_Class_Code = 0x109;

