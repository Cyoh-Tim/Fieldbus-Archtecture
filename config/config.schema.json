{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "multiproto-daemon config",
  "type": "object",
  "required": ["protocol", "device", "points"],
  "properties": {
    "protocol": {
      "type": "string",
      "enum": ["modbus_tcp", "slmp", "cclink", "ethernetip", "profinet"]
    },
    "device": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["server", "client"] }
      }
    },
    "cycle_ms": { "type": "integer", "minimum": 1, "default": 8 },
    "protocol_params": {
      "type": "object",
      "description": "프로토콜별 연결 파라미터. 코어는 해석하지 않고 선택된 어댑터에 그대로 전달한다. docs/design.md 3.3 절 참고."
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "access", "address"],
        "properties": {
          "name": { "type": "string" },
          "access": {
            "type": "string",
            "description": "read|write|readwrite (PLC 관점). 기본은 read|write."
          },
          "data_type": {
            "type": "string",
            "description": "uint8/16/32/64, int*, float32/64, bool, string/ascii, raw, bcd16/32 및 별칭(u16, REAL, qword …). 어댑터가 수용. 상세는 docs/modbus_stack.md, docs/slmp_stack.md."
          },
          "length": { "type": "integer" },
          "scale": { "type": "number", "default": 1.0 },
          "gain": { "type": "number", "description": "scale 별칭" },
          "offset": {
            "type": "number",
            "default": 0.0,
            "description": "엔지니어링 오프셋. eng = raw * scale + offset"
          },
          "byte_order": { "type": "string", "enum": ["big", "little"] },
          "word_order": {
            "type": "string",
            "enum": ["ab", "ba", "ABCD", "CDAB", "cdab"]
          },
          "endian": {
            "type": "string",
            "enum": ["ABCD", "BADC", "CDAB", "DCBA", "big", "little", "BE", "LE"],
            "description": "32/64비트 센서 엔디안. byte_order+word_order 대신 사용 가능"
          },
          "chars_per_register": { "type": "integer", "enum": [1, 2] },
          "chars_per_word": { "type": "integer", "enum": [1, 2] },
          "string_swap": { "type": "boolean" },
          "trim_null": { "type": "boolean", "default": true },
          "address": {
            "type": "object",
            "description": "선택된 protocol 서브키만 있으면 됨. modbus: register_type/type, start/address, offset, byte_offset, quantity/count, bit, bit_count, zero_based/address_base. slmp: device_code/device, start/address, unit, bit, bit_count."
          }
        }
      }
    }
  }
}
